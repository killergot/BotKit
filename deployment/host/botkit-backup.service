[Unit]
Description=Consistent BotKit backup with a brief polling pause
After=docker.service
Requires=docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/lib/botkit/scheduled-backup
TimeoutStartSec=15min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/botkit /var/lib/botkit
