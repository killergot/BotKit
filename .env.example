# Production: provision /etc/botkit/compose.env before deploying.
# Generate independent random values; never commit a real .env.
DB_NAME=bot_kit
BOT_TOKEN=replace-with-telegram-token
ID_ADMIN=replace-with-your-telegram-id
BOTKIT_DB_PASSWORD=replace-with-runtime-password
BOTKIT_MIGRATION_PASSWORD=replace-with-migration-password
POSTGRES_ADMIN_PASSWORD=replace-with-postgres-admin-password
REDIS_APP_PASSWORD=replace-with-redis-app-password
REDIS_ADMIN_PASSWORD=replace-with-redis-admin-password
REDIS_DB=0
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password
GRAFANA_IMAGE=grafana/grafana:12.1.10
BOTKIT_SECRETS_DIR=/etc/botkit
SCHEDULER_INTERVAL=300
