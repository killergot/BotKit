#!/bin/sh
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  'deploy '*) revision=${SSH_ORIGINAL_COMMAND#deploy };;
  *) echo 'Only deploy <40-character revision> is allowed' >&2; exit 64;;
esac
[ "${#revision}" -eq 40 ] || exit 64
case "$revision" in *[!0-9a-f]*) exit 64;; esac
exec /usr/bin/timeout --kill-after=30s 25m /usr/bin/sudo -n /usr/local/sbin/botkit-deploy "$revision"
